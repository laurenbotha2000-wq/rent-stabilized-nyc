rules_version = '2';

// Everything not matched below is denied.
//   listings/{chunk}, meta/status,
//   events/{id}                     read: signed-in users; write: only the sync job
//                                   (it uses the Admin SDK, which bypasses rules)
//   users/{uid}/searches/{id}       only that user, validated shape and size
//   users/{uid}/prefs/main          only that user, validated shape and size
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, and email verified when they used email + password
    // (Google and Apple accounts are already verified).
    function member() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'password'
            || request.auth.token.email_verified == true);
    }

    function isOwner(uid) {
      return member() && request.auth.uid == uid;
    }

    function validSearch(d) {
      let f = d.filters;
      return d.keys().hasOnly(['name', 'filters', 'created_at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.created_at is timestamp
        && f is map
        && f.keys().hasOnly(['hoods', 'beds', 'min', 'max', 'reason', 'features', 'commute', 'walk', 'lines', 'delisted', 'unflagged', 'noHazard', 'prewar'])
        && (!('noHazard' in f) || f.noHazard is bool)
        && (!('prewar' in f) || f.prewar is bool)
        && (!('commute' in f) || (f.commute is map
            && f.commute.keys().hasOnly(['label', 'lat', 'lng', 'minutes'])
            && f.commute.label is string && f.commute.label.size() <= 120
            && f.commute.lat is number && f.commute.lng is number
            && f.commute.minutes is number && f.commute.minutes >= 5 && f.commute.minutes <= 120))
        && (!('walk' in f) || (f.walk is number && f.walk > 0 && f.walk <= 30))
        && (!('lines' in f) || (f.lines is list && f.lines.size() <= 30))
        && (!('hoods' in f) || (f.hoods is list && f.hoods.size() <= 50))
        && (!('beds' in f) || (f.beds is list && f.beds.size() <= 6))
        && (!('min' in f) || f.min is number)
        && (!('max' in f) || f.max is number)
        && (!('reason' in f) || (f.reason is list && f.reason.size() <= 3))
        && (!('features' in f) || (f.features is list && f.features.size() <= 12))
        && (!('delisted' in f) || f.delisted is bool)
        && (!('unflagged' in f) || f.unflagged is bool);
    }

    function stringList(v, maxLen) {
      return v is list && v.size() <= maxLen;
    }

    function validPrefs(d) {
      return d.keys().hasOnly(['maxPrice', 'beds', 'hoods', 'near', 'must', 'nice', 'confidence', 'updated_at'])
        && d.updated_at == request.time
        && (!('maxPrice' in d) || d.maxPrice is number && d.maxPrice >= 0 && d.maxPrice <= 100000)
        && (!('beds' in d) || stringList(d.beds, 6))
        && (!('hoods' in d) || stringList(d.hoods, 50))
        && (!('must' in d) || stringList(d.must, 12))
        && (!('nice' in d) || stringList(d.nice, 12))
        && (!('confidence' in d) || d.confidence in ['likely', 'any'])
        && (!('near' in d) || (d.near is map
            && d.near.keys().hasOnly(['label', 'lat', 'lng', 'minutes'])
            && d.near.label is string && d.near.label.size() <= 120
            && d.near.lat is number && d.near.lng is number
            && d.near.minutes is number && d.near.minutes >= 5 && d.near.minutes <= 120));
    }

    // One private preferences document per person: users/{uid}/prefs/main
    match /users/{uid}/prefs/{doc} {
      allow read, delete: if isOwner(uid) && doc == 'main';
      allow create, update: if isOwner(uid) && doc == 'main' && validPrefs(request.resource.data);
    }

    // Read limits: listing chunks and status are fetched one known document
    // at a time (no listing whole collections), and queries must ask for a
    // small page, so nobody can pull everything in one request.
    match /listings/{chunk} {
      allow get: if member() && chunk.matches('c[0-9]{1,2}');
    }

    match /meta/{doc} {
      allow get: if member() && doc == 'status';
    }

    // Change log written by the sync job: new, price_change, delisted, relisted
    match /events/{id} {
      allow get: if member();
      allow list: if member() && request.query.limit <= 50;
    }

    match /users/{uid}/searches/{searchId} {
      allow get, delete: if isOwner(uid);
      allow list: if isOwner(uid) && request.query.limit <= 100;
      allow create: if isOwner(uid) && validSearch(request.resource.data)
        && request.resource.data.created_at == request.time;
      allow update: if isOwner(uid) && validSearch(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
    }
  }
}
