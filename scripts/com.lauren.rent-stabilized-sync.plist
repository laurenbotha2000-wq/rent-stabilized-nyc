<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-mac-poller.sh fills in the paths. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lauren.rent-stabilized-sync</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__POLLER__</string></array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/rent-stabilized-sync.err</string>
</dict>
</plist>
